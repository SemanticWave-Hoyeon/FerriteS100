# This file
.gitignore

# Rust build output (root + any nested workspace such as plugins/*/target)
/target/
**/target/

# Old catalogue location
/ProgramData/

# Catalogues - FC/PC included in repo, but allow excluding large files if needed
# /Catalogues/

# Chart data
/ChartData/

# Reference implementations
/reference/
/OpenS100/

# Logs
/logs/
*.log

# Instruction caches generated next to chart files
.ferrite_cache_*.bin

# Screenshot dumps from --screenshot
test_*.png
symbol_test.png

# Executables
*.exe
*.dll
*.so
*.dylib

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code session data
/.claude/
/claude.md

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Release distribution
/dist/
*.zip
# Markdown documents (planning, notes, etc.)
*.md

# S-1XX standard specification documents
/S1*.md
/S-1*.md

# S-1XX Catalogues (FC/PC for S-124, S-129, etc.)
/Catalogues/FC/S-124/
/Catalogues/FC/S-129/
/Catalogues/PC/S-124/
/Catalogues/PC/S-129/

# Planning documents
/plan/

# Standard specification documents (S-100, S-101, etc.)
/docs/

# s101-mcp / s101-explorer source ARE tracked — they live in FerriteS100
# proper now. Only their build artefacts and saved per-user plugin config
# are local. s101-mcp is a workspace member so the root Cargo.lock is the
# authoritative one — its in-tree Cargo.lock is local-only.
/plugins/s101-mcp/target/
/plugins/s101-mcp/Cargo.lock
/plugins/s101-explorer/target/
/plugins_out/s101-explorer/
/config/plugins/com.ferrite.s101-explorer.json
